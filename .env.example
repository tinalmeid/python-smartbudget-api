# === Ambiente ===
APP_ENV=development

# === JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))" ===
SECRET_KEY=TROQUE_POR_UM_VALOR_SECRETO_REAL
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Neon PostgreSQL — schemas separados por serviço ===
# Formato: postgresql://USER:PASS@HOST/neondb?sslmode=require&options=-csearch_path%3DSCHEMA%2Cpublic
DB_USUARIOS_URL=postgresql://usuario:senha@HOST/neondb?sslmode=require&options=-csearch_path%3Dpublic
DB_ORCAMENTO_URL=postgresql://usuario:senha@HOST/neondb?sslmode=require&options=-csearch_path%3Dorcamento%2Cpublic
DB_PREVISAO_URL=postgresql://usuario:senha@HOST/neondb?sslmode=require&options=-csearch_path%3Dprevisao%2Cpublic
DB_NOTIFICACOES_URL=postgresql://usuario:senha@HOST/neondb?sslmode=require&options=-csearch_path%3Dnotificacoes%2Cpublic

# === Kafka — Confluent Cloud ===
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=SUA_API_KEY_CONFLUENT
KAFKA_SASL_PASSWORD=SUA_API_SECRET_CONFLUENT

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === AWS ===
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
MLFLOW_S3_BUCKET=smartbudget-mlflow

# === Observabilidade ===
DATADOG_API_KEY=sua_api_key_datadog

# === Notificações ===
SENDGRID_API_KEY=SG.xxxxx
FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase_creds
